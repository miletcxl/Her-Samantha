{
  "name": "her-samantha",
  "version": "0.1.0",
  "description": "A narration and voice shell for agents.",
  "type": "module",
  "bin": {
    "samantha": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "agent",
    "narration",
    "tts",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/react": "^19.2.15",
    "ink": "^7.0.3",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.6"
  }
}
